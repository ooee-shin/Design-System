<?xml version="1.0" encoding="UTF-8"?>
<!-- 결정을 60초마다 읽고 처리할 것이 있을 때만 러너를 깨운다(scripts/harness/README.md 「launchd」).
     이 Mac 의 gh 로그인으로 돈다. PATH 는 launchd 가 기본으로 주지 않으므로 적어 둔다. `__HOME__` 은 설치할 때 sed 로 채운다(scripts/harness/README.md 「launchd」).
     Desktop 은 launchd 가 읽지 못해(TCC) 보호 밖의 사본에서 돈다. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ooee.harness.decisions</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__HOME__/.ooee-harness/harness/scripts/harness/watch-tick.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/.ooee-harness/harness</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/node/bin:__HOME__/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.ooee-harness/watch.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.ooee-harness/watch.log</string>
</dict>
</plist>
