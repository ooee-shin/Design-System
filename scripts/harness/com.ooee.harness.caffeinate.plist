<?xml version="1.0" encoding="UTF-8"?>
<!-- 전원 연결 중에만 잠자기를 막는다 — 감시가 1분마다 돌려면 Mac 이 깨어 있어야 한다(scripts/harness/README.md 「launchd」).
     `caffeinate -s` 는 전원 어댑터에 연결된 동안에만 시스템 잠자기를 막는다. 배터리로 돌 때와 덮개를 닫았을 때는 평소처럼 잠든다.
     오래 도는 프로세스라 KeepAlive 로 되살린다. 기기별 경로가 없어 `__HOME__` 이 없다. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ooee.harness.caffeinate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
