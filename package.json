{
  "name": "ooee-ui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "dev": "pnpm --filter @ooee/studio dev",
    "dev:studio": "pnpm --filter @ooee/studio dev",
    "build": "pnpm --filter @ooee/studio build",
    "lint": "pnpm --filter @ooee/studio lint",
    "test": "node --import tsx --test packages/*/src/*.test.ts packages/*/src/*.test.tsx apps/studio/src/components/*.test.ts",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "jsdom": "^30.0.1",
    "react-dom": "19.2.8",
    "tsx": "^4.23.12"
  }
}
